<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for CeeFind.

  Three values must be replaced with the ones Partner Center issues for the app,
  and the package will be rejected if they are left as they are. They are marked
  REPLACE below, and all three are found under Product Identity in Partner Center:

    Identity/@Name            the Package/Identity/Name value
    Identity/@Publisher       the Package/Identity/Publisher value, a full
                              distinguished name such as CN=ABCD1234-...
    PublisherDisplayName      the display name shown to customers

  The aliases are the point of packaging this at all. An alias registers a name
  that resolves to an executable, which is how f, c and cx reach the command line
  without the user editing a shell profile. All three point at the same binary;
  CeeFind reads the name it was invoked under and behaves accordingly.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="REPLACE.CeeFind"
    Publisher="CN=REPLACE"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>CeeFind</DisplayName>
    <PublisherDisplayName>REPLACE</PublisherDisplayName>
    <Logo>Assets\icon-50.png</Logo>
    <Description>Find files, and things inside them, by looking in likely places first.</Description>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763 is the first release with AppExecutionAlias support. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="CeeFind" Executable="ceefind.exe" EntryPoint="Windows.FullTrustApplication">

      <!--
        A console tool has no window to show, so it is hidden from the Start menu
        rather than listed there with a tile nobody can usefully click.
      -->
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="CeeFind"
        Description="Find files, and things inside them, by looking in likely places first."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\icon-150.png"
        Square44x44Logo="Assets\icon-44.png">
        <uap:DefaultTile Square310x310Logo="Assets\icon-310.png" Wide310x150Logo="Assets\wide-310x150.png" />
      </uap:VisualElements>

      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="ceefind.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="ceefind.exe" />
            <desktop:ExecutionAlias Alias="f.exe" />
            <desktop:ExecutionAlias Alias="c.exe" />
            <desktop:ExecutionAlias Alias="cx.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <!--
      CeeFind searches wherever it is pointed, which is the whole of its purpose,
      so it needs access beyond its own package. This capability requires
      justification during Store review; see Packaging/STORE.md.
    -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>

</Package>
