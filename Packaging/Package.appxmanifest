<?xml version="1.0" encoding="utf-8"?>

<!--
  MSIX manifest for CeeFind.

  Identity/@Name, Identity/@Publisher and PublisherDisplayName come from the
  Product Identity page in Partner Center for this app; if the app is ever
  re-created there under a new reservation, these three need updating to match.

  The aliases are the point of packaging this at all. An alias registers a name
  that resolves to an executable, which is how f and cx reach the command line
  without the user editing a shell profile. Both point at the same binary;
  CeeFind reads the name it was invoked under and behaves accordingly.

  c is deliberately not registered here. A child process can't change its
  caller's directory, so run as a bare alias it could only print the path -
  the same as --cd - which looks like it did nothing. c only works as the
  shell function ceefind init emits, which calls `ceefind --cd` by name and
  never needs this alias.
-->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="36541BlackWhiteL1.Ceefind"
    Publisher="CN=88B73C94-12D4-4F05-BEDE-2F7F384506F4"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>CeeFind</DisplayName>
    <PublisherDisplayName>Black &amp; White L1</PublisherDisplayName>
    <Logo>Assets\icon-50.png</Logo>
    <Description>Find files, and things inside them, by looking in likely places first.</Description>
  </Properties>

  <Dependencies>
    <!-- 10.0.17763 is the first release with AppExecutionAlias support. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="CeeFind" Executable="ceefind.exe" EntryPoint="Windows.FullTrustApplication">

      <!--
        A console tool has no window to show, and the first submission hid it from
        the Start menu with AppListEntry="none". The Store rejected that outright:
        a "headless app" needs the HeadlessAppBypass waiver, which this account does
        not have. So it is listed; launched from Start it opens a console showing
        usage, which is what every other command-line tool in the Store does.
      -->
      <uap:VisualElements
        DisplayName="CeeFind"
        Description="Find files, and things inside them, by looking in likely places first."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\icon-150.png"
        Square44x44Logo="Assets\icon-44.png">
        <uap:DefaultTile Square310x310Logo="Assets\icon-310.png" Wide310x150Logo="Assets\wide-310x150.png" />
      </uap:VisualElements>

      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="ceefind.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="ceefind.exe" />
            <desktop:ExecutionAlias Alias="f.exe" />
            <desktop:ExecutionAlias Alias="cx.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>

    </Application>
  </Applications>

  <Capabilities>
    <!-- Required by EntryPoint="Windows.FullTrustApplication" - a classic Win32
         executable rather than a sandboxed UWP app. -->
    <rescap:Capability Name="runFullTrust" />

    <!--
      CeeFind searches wherever it is pointed, which is the whole of its purpose,
      so it needs access beyond its own package. This capability requires
      justification during Store review; see Packaging/STORE.md.
    -->
    <rescap:Capability Name="broadFileSystemAccess" />
  </Capabilities>

</Package>
